# Скопируй в .env и заполни. Никаких кавычек не нужно.
PORT=3000
HOST=0.0.0.0
BOT_TOKEN=
APP_URL=https://your-app.example.com
# Только для локальной разработки! Не включать на публичном сервере.
DEMO_MODE=0
# Абсолютный путь к постоянному диску в production (например, /data)
DATA_DIR=./data
# Необязательно, применяется для ограничения доступа к служебному /health
NODE_ENV=development
